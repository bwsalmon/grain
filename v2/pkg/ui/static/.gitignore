# This directory is //go:embed'd by server.go, but its contents are
# generated by `npm run build` in ../frontend (see ../frontend/vite.config.js's
# outDir) -- not checked in, so a stale build can never ship instead of a
# real one. .gitkeep keeps the directory itself present on a fresh
# checkout, since go:embed fails to compile if it's missing outright.
*
!.gitignore
!.gitkeep
