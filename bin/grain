#!/bin/sh
# bwsalmon/agents#137: lets `grain ...` be run from anywhere, instead of
# requiring `cd` into this checkout first and spelling out `python3 -m
# grain.cli` (a package, not a script -- plain `python3 grain.cli` does not
# work at all). Meant to be symlinked onto PATH, e.g. `ln -sf
# /path/to/this/checkout/bin/grain /usr/local/bin/grain` -- see
# provision/controller.sh and terraform/gcp/files/deploy.sh for the two
# places that symlink is made automatically, and docs/runbook.md for the
# host, which has no such script since where an operator clones this repo
# isn't this project's to decide.
#
# Resolved with `readlink -f "$0"`, not `dirname "$0"`: reached through a
# PATH symlink (the whole point of installing this), `$0` is the symlink's
# own path, and `dirname` on that would give the symlink's directory
# (/usr/local/bin) rather than this checkout's root.
set -e
real_path=$(readlink -f "$0")
repo_root=$(cd "$(dirname "$real_path")/.." && pwd)
cd "$repo_root"
exec python3 -m grain.cli "$@"
