#!/bin/sh
# Installed by kontur's guest disk image build (see
# deploy/guest-image/README.md) and referenced from
# etc/ssh/sshd_config.d/10-console.conf's ForceCommand.
#
# `script` runs the session's real command (the interactive login shell,
# or whatever was given to `ssh host cmd`, via SSH_ORIGINAL_COMMAND) under
# its own pty and duplicates every byte the pty writes to a second file --
# here, the guest's serial console -- while still passing the session
# through to the real SSH client untouched.
set -eu
cmd="${SSH_ORIGINAL_COMMAND:-${SHELL:-/bin/bash} -l}"
exec script --quiet --flush --return --command "$cmd" /dev/console
