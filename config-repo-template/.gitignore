# Terraform state never belongs in git -- it lives in the GCS bucket
# config/backend.hcl points at.
.terraform/
.terraform.lock.hcl
*.tfstate
*.tfstate.*
crash.log

# Nor does anything holding a credential. Secrets go in this repo's
# Actions secrets and, from there, straight into the host's own instance
# metadata.
*.tfvars.json
*.auto.tfvars
*.json.key
*.pem
