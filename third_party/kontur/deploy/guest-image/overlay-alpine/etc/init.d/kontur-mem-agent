#!/sbin/openrc-run

description="Signal host-side kontur listener when this guest is under memory pressure"
command="/usr/local/bin/kontur-mem-agent"
command_background="yes"
pidfile="/run/${RC_SVCNAME}.pid"

depend() {
	after kontur-control-net
}

start_pre() {
	# Written by kontur-control-net when this guest has a control link,
	# naming the host address to signal. Absent on a guest booted
	# without one, which leaves the agent's own default (this guest's
	# default route's gateway) -- reaching the container network rather
	# than the host side of this VM, so nothing answers.
	if [ -f /run/kontur-control-net.env ]; then
		. /run/kontur-control-net.env
		export KONTUR_MEM_AGENT_HOST
	fi
}
