[Unit]
Description=Install the kontur exec SSH key from the kernel command line
# Both names: Debian's openssh-server ships ssh.service and an
# sshd.service alias, and a guest customization may have installed either.
# Ordering against a unit that does not exist is not an error.
Before=ssh.service sshd.service
After=local-fs.target
Requires=local-fs.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/libexec/kontur-authorized-key

[Install]
WantedBy=multi-user.target
