[Unit]
Description=Apply the container network's own routes to this guest
Documentation=file:///usr/local/libexec/kontur-configure-routes
# After the address exists and before anything uses it. The address comes
# either from the kernel itself (the bundled kernel acts on "ip=" before
# userspace starts) or from kontur-net-cmdline.service (a distro kernel,
# which does not) -- ordering after that unit covers both, since it runs
# either way and no-ops in the first case. DefaultDependencies=no for the
# same reason it has it: this is part of sysinit.target, and ordinary
# dependencies against that target would be a cycle.
DefaultDependencies=no
After=kontur-net-cmdline.service
Wants=kontur-net-cmdline.service
Before=network-pre.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/libexec/kontur-configure-routes

[Install]
WantedBy=sysinit.target
